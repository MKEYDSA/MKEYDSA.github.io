---
outlinks: true
---

<!DOCTYPE html>
<html lang="{{ info.lang }}">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="generator" content="{{ eleventy.generator }}">
    <link
      rel="icon"
      type="image/png"
      href="/static/img/icon/favicon-96x96.png"
      sizes="96x96" />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/static/img/icon/favicon.svg" />
    <link rel="shortcut icon" href="/static/img/icon/favicon.ico" />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/static/img/icon/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="{{ info.shortcode | upcase }} YDSA" />
    <link rel="manifest" href="/static/img/icon/site.webmanifest" />
    <link rel="stylesheet" href="/static/style/common.css">
    <link
      rel="stylesheet"
      href="/static/style/print.css"
      media="print">

    {%- if outlinks -%}
      {% comment %} link graphics flash on hover if not preloaded {% endcomment %}
      <link
        rel="preload"
        href="/static/img/outlink.svg"
        as="image"
        type="image/svg+xml" />
      <link
        rel="preload"
        href="/static/img/outlink-hover.svg"
        as="image"
        type="image/svg+xml" />
    {%- else -%}
      {% comment %} disable outlink graphic {% endcomment %}
      <link rel="stylesheet" href="/static/style/no-outlinks.css">
    {% endif %}

    {%- assign urlTitle = info.org -%}
    {%- if title -%}
      {% assign urlTitle = title | append: info.org %}
    {% endif %}
    <title>{{ urlTitle }}</title>

    <meta property="og:title" content="{{ title }}">
    <meta property="og:description" content="{{ content | excerpt }}">
    {%- if page.data.author -%}
      <meta property="og:author" content="{{ page.data.author }}">
    {% endif %}
    <meta propert="og:site_name" content="{{ info.org }}">
    <meta property="og:type" content="article">
    <meta property="og:url" content="{{ info.url | append: page.url }}">
    <meta property="og:image" content="{{ shareImage | default: "/static/img" }}">
    {%- if page.data.header.alt -%}
      <meta property="og:image:alt" content="page.data.header.alt">
    {% endif %}
  </head>
  <body>
    <div class="wrapper">
      <header>
        <div class="responsive-flex">
          {% comment %} use the org's logo for the home button {% endcomment %}
          <div>
            <a
              href="/"
              class="flex"
              style="flex-shrink: 0">
              <img src="/static/img/icon/logo.svg" style="margin-right: 15px; margin-bottom: calc(var(--spacing) / 3);">
            </a>
          </div>

          <nav class="right flex">
            <ul>
              {% for link in navigation %}
                <li
                  {% if link.subcategories or link.text == "chapters" %}
                  class="dropdown-label"
                  {% endif %}>
                  {% if link.url %}<a href="{{ link.url }}">{% endif %}
                  <span>{{ link.text }}</span>
                  {% if link.url %}</a>{% endif %}

                  {% comment %} dropdown stuff {% endcomment %}
                  {% if link.subcategories %}
                    <ul class="dropdown-content right">
                      {% for item in link.subcategories %}
                        <li>
                          <a href="{{ item.url }}">{{ item.text }}</a>
                        </li>
                      {% endfor %}
                    </ul>
                  {% endif %}
                </li>
              {% endfor %}

              {% comment %} nav items across all subdomains {% endcomment %}
              <li class="dropdown-label">
                <a href="{{ baseUrl | append: "/chapters/" }}">
                  <span>chapters</span>
                </a>
                <ul class="dropdown-content right">
                  {% for chapter in chapters %}
                    <li>
                      <a href="{{ chapter.link }}">{{ chapter.name }}</a>
                    </li>
                  {% endfor %}
                </ul>
              </li>

              <li>
                <a href="{{ baseUrl | append: "/posts/" }}">
                  <span>
                    posts
                  </span>
                </a>
              </li>
            </ul>
          </nav>
        </div>
        <hr>
      </header>

      {% if hero.title %}
        <div class="hero" style="
          background-image: url({{ hero.img | default: "/static/img/hero/index.png" }});
          background-color: var(--{{ hero.color | default: "red-tint-1" }})">
          <h1>{{ hero.title }}</h1>
        </div>
      {% endif %}

      <main>
        {{ content }}
      </main>

      <footer>
        <span>Copyright © YDSA@UWM</span>
      </footer>
    </div>
  </body>
</html>